<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- XML Documentation & IntelliSense Packaging -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppresses CS1591 warnings for missing XML comments -->
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Package Metadata -->
    <Authors>Tarek Mohamed</Authors>
    <Company>ModularOutbox</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/TarekMohame-d/ModularOutbox</RepositoryUrl>
    <PackageProjectUrl>https://github.com/TarekMohame-d/ModularOutbox</PackageProjectUrl>
    <PackageTags>outbox;transactional-outbox;postgresql;efcore;dotnet;modular-monolith</PackageTags>
    <Version>1.0.0-preview1</Version>

    <!-- README Metadata -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Source Link & Debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSymbols>true</IncludeSymbols>

    <!-- Default all projects to packable -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- Disable packing for test & sample projects across Windows, Linux, & macOS -->
  <PropertyGroup Condition="$(MSBuildProjectFullPath.Replace('\', '/').Contains('/tests/')) Or $(MSBuildProjectFullPath.Replace('\', '/').Contains('/samples/'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
